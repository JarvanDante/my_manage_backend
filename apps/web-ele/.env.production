VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/manage

# 媒资中心（生产请改为网关地址，Token 勿明文进前端仓库，宜改走服务端代理）
VITE_MEDIA_API_URL=/media-api
VITE_MEDIA_ADMIN_TOKEN=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
