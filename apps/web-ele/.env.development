# 端口号
VITE_PORT=5778

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/manage
VITE_PROXY_TARGET=http://host.docker.internal:8003

# 媒资中心 my_media（与 security.admin_token 一致；代理目标见 vite.config.mts → host.docker.internal:8004）
VITE_MEDIA_API_URL=/media-api
VITE_MEDIA_ADMIN_TOKEN=488ac147a8b24d2b0541b24f4fdfb5f8b10c20129f6b46fcce6d2091094e872a

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 统一存储 my_storage（代理见 vite.config.mts → host.docker.internal:8015）
VITE_STORAGE_API_URL=/storage-api
VITE_STORAGE_ADMIN_TOKEN=488ac147a8b24d2b0541b24f4fdfb5f8b10c20129f6b46fcce6d2091094e872a

# 广告中台 my_ad（代理见 vite.config.mts → host.docker.internal:8016）
VITE_AD_API_URL=/ad-api
VITE_AD_ADMIN_TOKEN=488ac147a8b24d2b0541b24f4fdfb5f8b10c20129f6b46fcce6d2091094e872a
